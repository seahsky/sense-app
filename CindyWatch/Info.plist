<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Cindy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- Marks this as a modern single-target watchOS app (no WatchKit Extension
	     bundle) and lets it launch on its own without requiring the iPhone app
	     to be reachable first. -->
	<key>WKApplication</key>
	<true/>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>

	<!-- Links this watch app to its iPhone companion app (CindyApp,
	     com.cindyapp.ios per project.yml). Required whenever a watch app has a
	     companion iOS app; since GENERATE_INFOPLIST_FILE is off for this target
	     (see entitlements-and-plist-notes.md), Xcode never auto-populates it. -->
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.cindyapp.ios</string>

	<!-- "workout-processing" is what actually keeps the app (and the active
	     HKWorkoutSession) alive in the background for the full AMRAP cap, and it
	     is also the precondition for CMBatchedSensorManager delivering any data
	     at all. It is one of six values WKBackgroundModes accepts
	     (workout-processing, self-care, mindfulness, physical-therapy, alarm,
	     underwater-depth) and the only one this app needs. Background audio /
	     haptic confirmation (WKInterfaceDevice.play, via HapticSignal) is
	     declared separately below via UIBackgroundModes, the same key iOS apps
	     use. No WKExtendedRuntimeSession is used anywhere in this app — see the
	     architecture spec, §5 "HealthKit workout configuration". -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>NSHealthShareUsageDescription</key>
	<string>Cindy reads your heart rate and active energy during a workout to show live stats and to save them with each completed session.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Cindy saves each completed Cindy AMRAP attempt to Health so its duration, heart rate, and active energy are recorded.</string>

	<!-- Core Motion has no requestAuthorization API for raw accelerometer or
	     device-motion data, so this key is the only permission surface for
	     automatic rep detection. Apple DTS states CMMotionManager has never
	     required it, and CMBatchedSensorManager's reference page documents
	     nothing either way — but Apple's usage-key list is explicitly
	     non-exhaustive and CMAltimeter was made to require the key in iOS 17.4
	     without ever being added to it. One string here is cheaper than a crash
	     on first sensor read mid-AMRAP. -->
	<key>NSMotionUsageDescription</key>
	<string>Cindy reads wrist motion during a workout to count your reps automatically. You can always log and correct reps by hand.</string>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
