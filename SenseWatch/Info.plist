<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SENSE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- Marks this as a modern single-target watchOS app (no WatchKit Extension
	     bundle) and lets it launch on its own without requiring the iPhone app
	     to be reachable first. -->
	<key>WKApplication</key>
	<true/>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>

	<!-- Links this watch app to its iPhone companion app (SenseApp,
	     com.senseapp.ios per project.yml). Required whenever a watch app has a
	     companion iOS app; since GENERATE_INFOPLIST_FILE is off for this target
	     (see entitlements-and-plist-notes.md), Xcode never auto-populates it. -->
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.senseapp.ios</string>

	<!-- "workout-processing" is what actually keeps the app (and the active
	     HKWorkoutSession) alive in the background for the full AMRAP cap, and it
	     is also the precondition for CMBatchedSensorManager delivering any data
	     at all. It is one of six values WKBackgroundModes accepts
	     (workout-processing, self-care, mindfulness, physical-therapy, alarm,
	     underwater-depth) and the only one this app needs. Background audio /
	     haptic confirmation (WKInterfaceDevice.play, via HapticSignal) is
	     declared separately below via UIBackgroundModes, the same key iOS apps
	     use. No WKExtendedRuntimeSession is used anywhere in this app — see the
	     architecture spec, §5 "HealthKit workout configuration". -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>NSHealthShareUsageDescription</key>
	<string>SENSE reads your heart rate and active energy during a workout to show live stats and to save them with each completed session.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>SENSE saves each completed Cindy AMRAP attempt to Health so its duration, heart rate, and active energy are recorded.</string>

	<!-- Core Motion has no requestAuthorization API for raw accelerometer or
	     device-motion data, so this key is the only permission surface for
	     automatic rep detection. Apple DTS states CMMotionManager has never
	     required it, and CMBatchedSensorManager's reference page documents
	     nothing either way — but Apple's usage-key list is explicitly
	     non-exhaustive and CMAltimeter was made to require the key in iOS 17.4
	     without ever being added to it. One string here is cheaper than a crash
	     on first sensor read mid-AMRAP. -->
	<key>NSMotionUsageDescription</key>
	<string>SENSE reads wrist motion during a workout to count your reps automatically. You can always log and correct reps by hand.</string>

	<!-- The app half of the complication's one-tap contract: the extension builds
	     sense://start?variant=<rawValue> via SenseDeepLink and ContentView.onOpenURL
	     parses it. Whether widgetURL strictly requires the scheme to be declared
	     here could not be settled locally, and not for want of trying — xcrun simctl
	     openurl is unsupported on the watchOS simulator and fails with
	     LSApplicationWorkspaceErrorDomain 115 even for a system scheme like
	     music://, so the unregistered case cannot be observed anywhere but on a
	     wrist. One block ends the argument. GENERATE_INFOPLIST_FILE is off for this
	     target (see entitlements-and-plist-notes.md), so nothing adds it for us.
	     The scheme string is duplicated in SenseDeepLink.scheme.
	     SenseDeepLinkTests reads THIS file off the source tree via #filePath and
	     asserts the schemes declared below contain that constant, so renaming
	     either half fails the suite rather than the wrist. That test is the only
	     thing watching this key: the watch app is not in the SenseKit test
	     bundle's dependency graph, so nothing else here is compiled or checked. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.senseapp.ios.watchkitapp.deeplink</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sense</string>
			</array>
		</dict>
	</array>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
